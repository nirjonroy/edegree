<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Strip 'www.' dynamically from any domain name
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 2. Force HTTPS dynamically for live domains, but keep XAMPP/local HTTP working
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 3. Map requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
